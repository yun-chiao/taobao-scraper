{
  "manifest_version": 3,
  "name": "淘寶抓圖小工具",
  "version": "1.0",
  "description": "一鍵抓取當前淘寶商品標題與主圖",
"permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobaocdn.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}