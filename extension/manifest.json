{
  "manifest_version": 3,
  "name": "Listio 上架所 — 淘寶/1688 → 蝦皮 AI 品牌化上架",
  "short_name": "Listio",
  "version": "2.0.0",
  "description": "在淘寶、天貓、1688 商品頁一鍵擷取，用 AI 寫出有品牌語氣的蝦皮文案、生成品牌首圖、匯出批量上傳檔。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "開啟 Listio 側邊欄",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.1688.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobaocdn.com/*",
    "https://*.tbcdn.cn/*",
    "https://seller.shopee.tw/*",
    "https://api.listio.app/*",
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*", "src/shared/*"],
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.1688.com/*",
        "https://seller.shopee.tw/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
  }
}
